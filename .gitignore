# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# tooling caches
/src/graphify-out/
/graphify-out/

# claude code — local-only settings
.claude/settings.local.json

# demo / presentation assets (regenerated by demo-slides/generate_slides.py)
/demo-slides/

# local https certificate for `npm run dev` (mkcert: localhost.pem + localhost-key.pem)
certificates/

# scratch space used while probing the API from the terminal
.scratch/
